+        set(NETDATA_LIBBACKTRACE_LIBRARIES "${LIBBACKTRACE_LIBRARY}" PARENT_SCOPE)
         set(HAVE_LIBBACKTRACE TRUE PARENT_SCOPE)
-
-        message(STATUS "Finished preparing libbacktrace")
 endfunction()
 
